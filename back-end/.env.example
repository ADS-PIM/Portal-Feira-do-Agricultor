DB_HOST=localhost
DB_PORT=3306
DB_NAME=api_portal_feira
DB_USER=root
DB_PASSWORD=
DB_SSL=false
DB_SSL_CA=

# Cloudinary Product Environment Credentials (somente no backend; nunca VITE_).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Alternativa aos 3 campos acima: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# Preencha os 3 campos OU somente esta URL. Os campos têm prioridade.
CLOUDINARY_URL=

# Legado: manter apenas enquanto houver fotos antigas no Vercel Blob.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=

# Recuperação de senha: configure somente no backend (nunca com prefixo VITE_).
RESEND_API_KEY=
EMAIL_FROM="Brotando Feiras <onboarding@resend.dev>"
# URL única do frontend, sem hash/query. Na Vercel use https://seu-site.vercel.app
PASSWORD_RESET_FRONTEND_URL=http://localhost:5173

# Token Bucket: as capacidades abaixo são repostas gradualmente em 15 minutos.
# Execute npm run db:migrate antes de iniciar/publicar o backend.
RATE_LIMIT_STORE=mysql
RATE_LIMIT_LOGIN_CAPACITY=5
RATE_LIMIT_PUBLIC_CAPACITY=300
RATE_LIMIT_AUTHENTICATED_CAPACITY=300
RATE_LIMIT_PASSWORD_CAPACITY=5
RATE_LIMIT_PASSWORD_RECOVERY_CAPACITY=5
RATE_LIMIT_REGISTRATION_CAPACITY=5
RATE_LIMIT_MESSAGE_CAPACITY=10
RATE_LIMIT_SESSION_CAPACITY=30
RATE_LIMIT_ANONYMOUS_CAPACITY=60

# Vazio: conexão direta local; na Vercel, confia em um salto do proxy da plataforma.
# Em outro proxy, informe seus IPs/sub-redes ou o número exato de saltos confiáveis.
TRUST_PROXY=

# Pesquisa de locais (API compatível com Photon). O serviço público não exige chave.
# Para maior volume/disponibilidade, use uma instância dedicada via HTTPS.
LOCATION_SEARCH_URL=https://photon.komoot.io/api/
RATE_LIMIT_GEOCODING_CAPACITY=30
